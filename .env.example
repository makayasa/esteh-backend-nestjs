# Esteh backend — template environ.
# Copy ke `.env` dan mengisi nilai. `.env` tidak pernah di-git-commit.
# Semua nilai di bawah development/local; tidak gunakan secret produksi.

# App
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Simpan stabil di luar DB. Rotasi mencabut seluruh token session lama.
SESSION_SECRET=
# Direktori bukti QRIS privat (Q27). Default `uploads` relatif cwd;
# di Compose cocok dengan volume uploads:/app/uploads.
# EVIDENCE_DIR=uploads
PORT=3000
# Bind host untuk publikasi port Compose; default localhost saja.
# Compose memakai HOST=0.0.0.0 dan PORT=3000 di dalam container.
# Hanya ke 0.0.0.0 pada LAN tepercaya untuk uji integrasi dengan data sintetis
# (baca README). Tidak pernah dipublikasikan ke internet pada tahap MVP.
HOST=127.0.0.1

# PostgreSQL (service `db` dalam docker-compose)
POSTGRES_USER=esteh
POSTGRES_PASSWORD=vervang-dit-met-een-willekeurig-wachtwoord
POSTGRES_DB=esteh

# String koneksi Prisma, dilihat dari dalam container app. Host `db` adalah
# service dalam docker-compose. Jalankan CLI migration di container;
# mengganti `@db` menjadi `@localhost` tidak membuka akses DB dari host.
DATABASE_URL=postgresql://esteh:vervang-dit-met-een-willekeurig-wachtwoord@db:5432/esteh
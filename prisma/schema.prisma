// Esteh backend — Prisma schema.
// P0: schema kosong selain generator/datasource untuk membuktikan koneksi DB.
// Rancangan tabel domain per tahap (P1+), bukan semua sekaligus.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String
  role         String
  active       Boolean @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  sales        Sale[]
  receipts     Receipt[]
  purchases    Purchase[]
  ledger       StockLedger[]
  expenses     Expense[]
  refunds      Refund[]
  salesOccurred    Sale[] @relation("SaleOccurrence")
  salesCancelled   Sale[] @relation("SaleCancellation")
}

model Session {
  id         String @id @default(uuid())
  accountId  String
  account    Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tokenHash  String @unique
  createdAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  @@index([accountId])
}

model Audit {
  id        String @id @default(uuid())
  actorId   String
  action    String
  objectId  String
  createdAt DateTime @db.Timestamptz(3)
}

model Idempotency {
  actorId     String
  operation   String
  key         String
  payloadHash String
  result      Json
  @@id([actorId, operation, key])
}

model Material {
  id            String @id @default(uuid())
  name          String
  unit          String
  quantityScale Int
  active        Boolean @default(true)
  // Stok tersimpan dalam mikro satuan (10^-3) agar atomik & non-negatif di DB.
  stock         Int @default(0)
  items         PurchaseItem[]
  ledger        StockLedger[]
}

model Product {
  id        String @id @default(uuid())
  name      String
  price     Int
  available Boolean
  active    Boolean @default(true)
  saleItems SaleItem[]
}

// Penjualan: harga snapshot pada saat kejadian; tidak mengikuti harga katalog.
// occurredAt = waktu kejadian; recordedAt/recordedBy = waktu & pelaku input (Q12).
// method 'qris': pending sampai konfirmasi (Q10); bukti privat di volume (Q27).
// P6: koreksi lama/pengganti (Q20/Q25), input susulan (Q12/Q23), pembatalan.
model Sale {
  id           String @id @default(uuid())
  occurredAt   DateTime @db.Timestamptz(3)
  recordedAt   DateTime @db.Timestamptz(3)
  recordedBy   String
  account      Account @relation(fields: [recordedBy], references: [id])
  method       String @default("cash")
  evidencePath String?
  evidenceMime String?
  evidenceSize Int?
  evidenceAt   DateTime? @db.Timestamptz(3)
  evidenceBy   String?
  correctsId   String? @unique
  corrects     Sale? @relation("SaleCorrection", fields: [correctsId], references: [id])
  correctedById String? @unique
  correctedBy  Sale? @relation("SaleCorrection")
  occurredBy   String?
  occurredByAccount Account? @relation("SaleOccurrence", fields: [occurredBy], references: [id])
  manualRef    String?
  reason       String?
  cancelledAt  DateTime? @db.Timestamptz(3)
  cancelledBy  String?
  cancelledByAccount Account? @relation("SaleCancellation", fields: [cancelledBy], references: [id])
  cancelReason String?
  items        SaleItem[]
  receipt      Receipt?
  refund       Refund?
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  sale      Sale @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  unitPrice Int
  quantity  Int
  @@index([saleId])
}

// Penerimaan Pembayaran: satu per penjualan, nominal dihitung backend.
model Receipt {
  id            String @id @default(uuid())
  saleId        String @unique
  sale          Sale @relation(fields: [saleId], references: [id])
  method        String
  amount        Int
  receivedAt    DateTime @db.Timestamptz(3)
  receivedBy    String
  account       Account @relation(fields: [receivedBy], references: [id])
  // Q26: referensi merchant/alasan hanya untuk konfirmasi QRIS tanpa bukti.
  merchantRef   String?
  confirmReason String?
}

model LoginLimit {
  bucket  String @id
  startAt DateTime @db.Timestamptz(3)
  count   Int
}

// Refund penuh setelah uang benar-benar dikembalikan (Q11/Q21): satu per
// penjualan lunas, nominal selalu sama dengan penerimaan (trigger DB).
model Refund {
  id         String @id @default(uuid())
  saleId     String @unique
  sale       Sale @relation(fields: [saleId], references: [id])
  amount     Int
  method     String
  reason     String
  occurredAt DateTime @db.Timestamptz(3)
  recordedAt DateTime @db.Timestamptz(3)
  recordedBy String
  account    Account @relation(fields: [recordedBy], references: [id])
}

// Pembelian sudah dibayar penuh dan diterima sekaligus (Q17); stok bertambah
// tepat sekali lewat ledger atomik dalam transaksi yang sama. Koreksi
// menghubungkan catatan lama/pengganti tanpa hard-delete (Q36).
model Purchase {
  id            String @id @default(uuid())
  occurredAt    DateTime @db.Timestamptz(3)
  recordedAt    DateTime @db.Timestamptz(3)
  recordedBy    String
  account       Account @relation(fields: [recordedBy], references: [id])
  correctsId    String? @unique
  corrects      Purchase? @relation("PurchaseCorrection", fields: [correctsId], references: [id])
  correctedById String? @unique
  correctedBy   Purchase? @relation("PurchaseCorrection")
  items         PurchaseItem[]
}

model PurchaseItem {
  id             String @id @default(uuid())
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id])
  // materialId null = pembelian alat; tidak menyentuh stok bahan (Q8/Q17).
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id])
  name           String
  quantityMicros Int
  unit           String?
  cost           Int
  @@index([purchaseId])
}

// Ledger mutasi stok: satu-satunya sumber riwayat perubahan stok; kolom
// Material.stock selalu diperbarui bersama ledger dalam transaksi yang sama.
model StockLedger {
  id          String @id @default(uuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  kind        String
  deltaMicros Int
  reason      String?
  purchaseId  String?
  correctsId  String? @unique
  corrects    StockLedger? @relation("LedgerCorrection", fields: [correctsId], references: [id])
  correctedBy StockLedger? @relation("LedgerCorrection")
  occurredAt  DateTime @db.Timestamptz(3)
  recordedAt  DateTime @db.Timestamptz(3)
  recordedBy  String
  account     Account @relation(fields: [recordedBy], references: [id])
  @@index([materialId])
}

// Pengeluaran operasional terpisah dari pembelian dan refund (CONTEXT.md).
model Expense {
  id            String @id @default(uuid())
  category      String
  amount        Int
  note          String?
  occurredAt    DateTime @db.Timestamptz(3)
  recordedAt    DateTime @db.Timestamptz(3)
  recordedBy    String
  account       Account @relation(fields: [recordedBy], references: [id])
  correctsId    String? @unique
  corrects      Expense? @relation("ExpenseCorrection", fields: [correctsId], references: [id])
  correctedById String? @unique
  correctedBy   Expense? @relation("ExpenseCorrection")
}